{
  "name": "festive-express-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:admin": "dotenv -e .env -- turbo run dev --filter=admin",
    "dev:storefront": "dotenv -e .env -- turbo run dev --filter=storefront",
    "build": "dotenv -e .env -- turbo run build",
    "build:admin": "turbo run build --filter=admin",
    "build:storefront": "turbo run build --filter=storefront",
    "clean": "git clean -Xdf node_modules",
    "vercel-build": "turbo run build --filter=storefront"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "turbo": "^2.0.0"
  }
}
